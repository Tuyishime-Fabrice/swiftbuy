# ─────────────────────────────────────────────────────────────────────────────
#  SwiftBuy — environment variables
#
#  Copy this file to `.env` and fill in the values from your Supabase project.
#  `.env` is gitignored; never commit real credentials.
#
#  Everything here is exposed to the browser by Vite, which is why only
#  public-safe values belong in this file. The anon key is a public identifier,
#  not a secret: what a browser holding it may read and write is decided by Row
#  Level Security in the database (supabase/migrations/0002_security.sql).
# ─────────────────────────────────────────────────────────────────────────────

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase → Project Settings → API → Project API keys → anon / public
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ─────────────────────────────────────────────────────────────────────────────
#  NEVER put these in this file or anywhere under src/
# ─────────────────────────────────────────────────────────────────────────────
#
#  SUPABASE_SERVICE_ROLE_KEY   bypasses every RLS policy. It belongs only in an
#                              Edge Function's secrets or a server environment.
#  Payment gateway credentials no gateway is integrated yet; when one is, its
#                              keys go server-side, and the callback lands on
#                              public.confirm_payment_from_provider(), which is
#                              revoked from anon and authenticated.
#
#  Without VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY the app shows a setup
#  screen. It deliberately has no offline mode — a marketplace that stores
#  orders per-browser looks like it works and does not.
