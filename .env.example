# SwiftBuy Rwanda — Environment Variables
# Copy this file to .env and fill in your Supabase credentials.
# DO NOT commit .env to git — it's already in .gitignore.

# ── Supabase ────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → Your Project → Settings → API

VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ── Without these set ───────────────────────────────────────────────────────
# The app runs in localStorage mode (demo/offline mode).
# All features work, but data is per-browser and not shared.
